# Detector image for the Jetson Orin Nano (JetPack 6): Ultralytics' Jetson image already has CUDA,
# TensorRT and NVIDIA's PyTorch build. Used by docker-compose.jetson.yml, see jetson/README.md.
# Pinned to the exact build the TensorRT engines were made with (pulled 2026-10-09): a newer "latest" can bring
# another TensorRT, and engines only load in the version that built them. To update: pull, rebuild the engines
# (jetson/README.md), then put the new digest here (docker image inspect ... --format '{{index .RepoDigests 0}}').
FROM ultralytics/ultralytics:latest-jetson-jetpack6@sha256:ff4f25b3c136c536482ae8001a73fbd44c4d341d5cf031e9553899b1c99c6785

WORKDIR /app

# v4l2-ctl sets camera controls (50 Hz anti-flicker) on every start, see camera.py
RUN apt-get update && apt-get install -y --no-install-recommends v4l-utils \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir "redis>=5.0.0"
COPY requirements-media.txt .
RUN pip install --no-cache-dir -r requirements-media.txt
# face recognition (faces.py) runs ArcFace with onnxruntime. The Ultralytics Jetson image normally has it
# (with CUDA); only install the CPU build if it is missing, and carry on without it if that fails
# (faces.py then falls back to OpenCV).
RUN python3 -c "import onnxruntime" 2>/dev/null || pip install --no-cache-dir "onnxruntime>=1.17" || true

COPY *.py ./

CMD ["python3", "main.py"]
