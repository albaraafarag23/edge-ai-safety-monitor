# Copy to .env and fill in values before running docker compose

POSTGRES_DB=safety_monitor
POSTGRES_USER=monitor
POSTGRES_PASSWORD=monitor123

# CV source: 0 = webcam, or path to a video file e.g. /path/to/video.mp4
CV_SOURCE=0
PLUGIN_ID=construction_safety
# Shown on the dashboard's camera page
CAMERA_LOCATION=Main site
# More than one camera: copy config/cameras.example.json to config/cameras.json and list them there
# (it replaces CV_SOURCE and CAMERA_LOCATION above).
# Days to keep incident snapshots and clips. Empty = keep forever (watch the disk on an always-on device).
MEDIA_KEEP_DAYS=
# Face recognition (console > People): auto = on when the face models are in models/
# (scripts/get-face-models.sh), off = never. FACE_DEVICE: cpu, or cuda where onnxruntime has CUDA.
FACE_RECOGNITION=auto
FACE_DEVICE=cpu

# Dashboard sign-in. The first backend start creates this manager account. If ADMIN_PASSWORD is empty,
# a random password is generated and printed once in `docker compose logs backend`.
# More accounts: docker compose exec backend python manage.py create-user <email> "<name>"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# A shared, read-only account for visitors and examiners (optional). It can look at everything and change
# nothing, including its own password. Both empty = no such account. At least 8 characters.
DEMO_EMAIL=
DEMO_PASSWORD=
# Signs session cookies. Set a long random value (python3 -c "import secrets; print(secrets.token_hex(32))"),
# otherwise everyone is signed out whenever the backend restarts.
AUTH_SECRET=
# true when the dashboard is served over HTTPS
COOKIE_SECURE=false
# Shared secret that lets ai_reporting save reports to the backend. Change it outside local development.
INTERNAL_API_TOKEN=dev-internal-token

# AI reports: Claude API key (https://console.anthropic.com). Without it, reports use a fixed template.
ANTHROPIC_API_KEY=
# Or Gemini writes the reports (used when there is no Claude key): the same key as SiteSentry Regs,
# free at https://aistudio.google.com/apikey. LLM_PROVIDER=claude or gemini to choose when both are set.
GEMINI_API_KEY=
# Report languages: English always; "en,ar" also writes an Arabic version (shown when the console is in Arabic)
REPORT_LANGUAGES=en,ar
# Language of the alert email: en or ar
EMAIL_LANGUAGE=en

# Email to the supervisor. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, and an App Password
# (Google account > Security > App passwords), not your normal password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Who gets alert emails is chosen by each person on the console's Account page (managers and supervisors:
# High and Critical by default; viewers: none). So once SMTP is set, every manager and supervisor account gets
# email. SUPERVISOR_EMAILS is an optional fixed extra list; it gets incidents from EMAIL_MIN_SEVERITY up and the summary.
SUPERVISOR_EMAILS=
EMAIL_MIN_SEVERITY=HIGH
# Public address of the console, for the "Open this incident" button in alert emails (optional)
CONSOLE_URL=
# Seconds before the same rule on the same camera is emailed again
NOTIFY_COOLDOWN_S=300
# End-of-day summary email (to the people who ask for it on their Account page) at this site time (SITE_TIMEZONE), e.g. 18:00. Empty = off.
# Only the starting value: the manager chooses the time in the console (Notifications), and that choice wins.
DIGEST_TIME=
# A failed email or report save is retried (30 s, 1 min, 2 min, ... up to 15 min apart) until this many seconds
RETRY_GIVE_UP_S=86400
# Live view: pictures a second and their JPEG quality (30-95). Lower the quality on a slow upload line.
LIVE_FPS=30
LIVE_QUALITY=70
# Frames a second asked of a USB camera. 60 on the Jetson when a sharp 1080p picture loses frames (jetson/README.md)
CAMERA_FPS=30
# v4l2 controls set when the camera opens (default: power_line_frequency=1, 50 Hz mains)
CAMERA_CONTROLS=
