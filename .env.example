# Copy to .env and fill in values before running docker compose

POSTGRES_DB=safety_monitor
POSTGRES_USER=monitor
POSTGRES_PASSWORD=monitor123

# CV source: 0 = webcam, or path to a video file e.g. /path/to/video.mp4
CV_SOURCE=0
PLUGIN_ID=construction_safety
# Shown on the dashboard's camera page
CAMERA_LOCATION=Main site

# Dashboard sign-in. The first backend start creates this admin account. If ADMIN_PASSWORD is empty,
# a random password is generated and printed once in `docker compose logs backend`.
# More accounts: docker compose exec backend python manage.py create-user <email> "<name>"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Signs session cookies. Set a long random value (python3 -c "import secrets; print(secrets.token_hex(32))"),
# otherwise everyone is signed out whenever the backend restarts.
AUTH_SECRET=
# true when the dashboard is served over HTTPS
COOKIE_SECURE=false
# Shared secret that lets ai_reporting save reports to the backend. Change it outside local development.
INTERNAL_API_TOKEN=dev-internal-token

# AI reports: Claude API key (https://console.anthropic.com). Without it, reports use a fixed template.
ANTHROPIC_API_KEY=

# Email to the supervisor. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, and an App Password
# (Google account > Security > App passwords), not your normal password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SUPERVISOR_EMAILS=supervisor@example.com
# Public address of the console, for the "Open this incident" button in alert emails (optional)
CONSOLE_URL=
# Seconds before the same rule on the same camera is emailed again
NOTIFY_COOLDOWN_S=300
# A failed email or report save is retried (30 s, 1 min, 2 min, ... up to 15 min apart) until this many seconds
RETRY_GIVE_UP_S=86400
