# Copy to .env and fill in values before running docker compose

POSTGRES_DB=safety_monitor
POSTGRES_USER=monitor
POSTGRES_PASSWORD=monitor123

# CV source: 0 = webcam, or path to a video file e.g. /path/to/video.mp4
CV_SOURCE=0
PLUGIN_ID=construction_safety

# AI reports: Claude API key (https://console.anthropic.com). Without it, reports use a fixed template.
ANTHROPIC_API_KEY=

# Email to the supervisor. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, and an App Password
# (Google account > Security > App passwords), not your normal password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SUPERVISOR_EMAILS=supervisor@example.com
# Seconds before the same rule on the same camera is emailed again
NOTIFY_COOLDOWN_S=300
